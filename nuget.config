<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Repo-authoritative: `<clear />` drops user- and machine-level sources so restore is
         deterministic everywhere. This matters beyond this repo — saas and community build
         foundation's projects directly by reference in local development, and NuGet picks
         the config nearest each project, so without this file those builds inherit whatever
         feeds the developer happens to have configured.

         Only nuget.org: foundation consumes no Orkyo.* packages (it produces them), and
         publishing pushes to an explicit URL rather than a configured source name. -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <!-- Central Package Management requires every configured source to be mapped (NU1507). -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>

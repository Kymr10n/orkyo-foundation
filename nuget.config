<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Repo-authoritative: drop any user- or machine-level sources so restore is
         deterministic everywhere. Foundation's projects are also restored from a
         sibling context (saas and community reference them directly in local dev),
         and NuGet picks the config nearest each project — without this file those
         builds inherit whatever feeds the developer happens to have configured. -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <!-- Central Package Management requires every configured source to be mapped
       (NU1507). Foundation restores everything from nuget.org; the GitHub Packages
       source appears only where a workflow or Dockerfile adds it, under one of two
       names, so both are mapped. A mapping for an absent source is inert. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="github">
      <package pattern="Orkyo.*" />
    </packageSource>
    <packageSource key="Source">
      <package pattern="Orkyo.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>

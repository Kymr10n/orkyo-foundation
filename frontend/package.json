{
  "name": "@kymr10n/foundation",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "type": "module",
  "files": [
    ".tsbuild",
    "assets"
  ],
  "exports": {
    "./src/*": {
      "types": "./.tsbuild/src/*.d.ts",
      "default": "./.tsbuild/src/*.js"
    },
    "./contracts/*": {
      "types": "./.tsbuild/contracts/*.d.ts",
      "default": "./.tsbuild/contracts/*.js"
    }
  },
  "scripts": {
    "prepublishOnly": "npm run build && mkdir -p assets && cp -r ../assets/orkyo-favicon-pack/. assets/",
    "build": "tsc -b && tsc-alias -p tsconfig.json && find src -name '*.css' | xargs cp --parents -t .tsbuild/",
    "typecheck": "tsc -b && tsc-alias -p tsconfig.json",
    "test": "vitest run",
    "test:browsers": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:mobile": "playwright test --project=mobile-webkit --project=mobile-chromium --project=tablet-webkit",
    "lint": "eslint src contracts --max-warnings=0"
  },
  "peerDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fullcalendar/core": "^6.1.20",
    "@fullcalendar/daygrid": "^6.1.20",
    "@fullcalendar/interaction": "^6.1.20",
    "@fullcalendar/list": "^6.1.21",
    "@fullcalendar/react": "^6.1.20",
    "@fullcalendar/timegrid": "^6.1.20",
    "@radix-ui/react-alert-dialog": "^1.1.17",
    "@radix-ui/react-checkbox": "^1.3.5",
    "@radix-ui/react-collapsible": "^1.1.14",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@radix-ui/react-popover": "^1.1.17",
    "@radix-ui/react-scroll-area": "^1.2.12",
    "@radix-ui/react-select": "^2.3.1",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.3.1",
    "@radix-ui/react-tabs": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.10",
    "@radix-ui/react-visually-hidden": "^1.2.4",
    "@tanstack/react-query": "^5.0.0",
    "@tanstack/react-table": "^9.1.2",
    "@tanstack/react-virtual": "^3.14.3",
    "@xstate/react": "^6.1.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "lucide-react": "^1.20.0",
    "react": "^19.0.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.0.0",
    "react-router": "^8.3.0",
    "recharts": "^3.8.1",
    "xstate": "^5.32.1",
    "zustand": "^5.0.0"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "jspdf": "^4.2.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "0.5.5",
    "exceljs": "^4.4.0",
    "globals": "17.11.0",
    "happy-dom": "20.12.0",
    "jest-axe": "^11.0.0",
    "tailwindcss": "^4.3.3",
    "tsc-alias": "^1.9.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "overrides": {
    "ws": "^8.21.0",
    "dompurify": "^3.4.10",
    "js-yaml": "^4.2.0",
    "exceljs": {
      "uuid": "^11.1.1"
    },
    "brace-expansion": "^1.1.18"
  }
}

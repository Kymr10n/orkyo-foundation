# synced-files.manifest — files that are intentionally byte-identical across repos.
# The template-sync-check workflow (G4) fails when a consumer copy drifts from its
# source. This makes the fork visible so someone opens a sync PR — or, if the fork
# is intentional, deletes the row here (the manifest IS the allowlist).
#
# There is NO runtime coupling: nothing in one repo imports another at build/run
# time. Sync is a review-time discipline, verified asynchronously in CI.
#
# Format (tab-separated):  <repo-relative-path>\t<source-repo>\t<consumer-repos,comma-separated>
# Lines starting with # and blank lines are ignored.
#
# See orkyo-infra/docs/optimization-plan-2026-07.md §Guardrails (G4).

scripts/ci/lint-migration-headers.sh	orkyo-foundation	orkyo-saas,orkyo-community
scripts/ci/check-dead-registrations.py	orkyo-foundation	orkyo-saas,orkyo-community
scripts/ci/check-stale-markers.sh	orkyo-foundation	orkyo-saas,orkyo-community
global.json	orkyo-foundation	orkyo-saas,orkyo-community
scripts/check-env.sh	orkyo-saas	orkyo-community
Directory.Build.props	orkyo-saas	orkyo-community
nuget.config	orkyo-saas	orkyo-community
frontend/eslint.config.js	orkyo-saas	orkyo-community
frontend/src/index.css	orkyo-saas	orkyo-community
scripts/bump-foundation.sh	orkyo-saas	orkyo-community
scripts/check-foundation-parity.sh	orkyo-saas	orkyo-community
frontend/scripts/sync-foundation-build.mjs	orkyo-saas	orkyo-community
frontend/scripts/validate-foundation-imports.mjs	orkyo-saas	orkyo-community
frontend/scripts/check-dedupe-sync.mjs	orkyo-saas	orkyo-community
frontend/src/test/vite-config.test.ts	orkyo-saas	orkyo-community
frontend/scripts/check-foundation-peers.mjs	orkyo-saas	orkyo-community
.editorconfig	orkyo-saas	orkyo-community

# Agent configuration: the STE hook and the vendored simple-english skill are byte-identical
# in every repo (2026-09 review, X3). Documentation and infra are not checked out by the
# workflow, so only the two products are listed; infra's settings.json differs by design.
.claude/hooks/ste-check.py	orkyo-foundation	orkyo-saas,orkyo-community
.claude/skills/simple-english/LICENSE	orkyo-foundation	orkyo-saas,orkyo-community
.claude/skills/simple-english/SKILL.md	orkyo-foundation	orkyo-saas,orkyo-community
.claude/skills/simple-english/UPSTREAM.md	orkyo-foundation	orkyo-saas,orkyo-community
.claude/skills/simple-english/ste_lint.py	orkyo-foundation	orkyo-saas,orkyo-community
.claude/skills/simple-english/references/checklist.md	orkyo-foundation	orkyo-saas,orkyo-community
.claude/skills/simple-english/references/use-cases.md	orkyo-foundation	orkyo-saas,orkyo-community

# Product-shared configuration that was already byte-identical but unguarded (2026-09
# declutter, second pass): the Node version pin, the frontend TypeScript config, the agent
# settings, two .gitignore stubs, and the README logos.
.nvmrc	orkyo-saas	orkyo-community
frontend/tsconfig.json	orkyo-saas	orkyo-community
.claude/settings.json	orkyo-saas	orkyo-community
.claude/.gitignore	orkyo-saas	orkyo-community
frontend/public/.gitignore	orkyo-saas	orkyo-community
.github/orkyo-logo-light.png	orkyo-saas	orkyo-community
.github/orkyo-logo-dark.png	orkyo-saas	orkyo-community

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="GitHubActionsTestLogger" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Moq" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <!--
      Transitive security pin, not a dependency this project uses directly. Testcontainers
      pulls SSH.NET, and every version <= 2025.1.0 carries GHSA-q939-rpr3-3284 (High): a
      recursive ScpClient download honours server-controlled filenames and can write outside
      the target directory. Testcontainers has no release referencing the patched 2026.0.0
      yet, so the version is forced here. Drop this line once Testcontainers.PostgreSql
      resolves 2026.0.0 or later on its own.
    -->
    <PackageReference Include="SSH.NET" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="AwesomeAssertions" />
    <Using Include="Moq" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\testsupport\Orkyo.Foundation.TestSupport.csproj" />
    <ProjectReference Include="..\core\Orkyo.Foundation.Core.csproj" />
    <ProjectReference Include="..\src\Orkyo.Foundation.Web.csproj" />
    <ProjectReference Include="..\seeding\Orkyo.Foundation.Seed.csproj" />
    <ProjectReference Include="..\migration-abstractions\Orkyo.Migration.Abstractions.csproj" />
    <ProjectReference Include="..\migrator-runtime\Orkyo.Migrator.csproj" />
    <ProjectReference Include="..\migrations-foundation\Orkyo.Foundation.Migrations.csproj" />
  </ItemGroup>

</Project>

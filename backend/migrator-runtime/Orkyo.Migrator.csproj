<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Orkyo.Migrator</RootNamespace>
    <AssemblyName>Orkyo.Migrator</AssemblyName>

    <PackageId>Orkyo.Migrator</PackageId>
    <Description>Migration runner for Orkyo. Composes IMigrationModule registrations into Apply/ValidateOnly executions against a single Postgres database, with advisory locking, checksum validation, and an explicit history table (orkyo_schema_migrations).</Description>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="dbup-core" />
    <PackageReference Include="dbup-postgresql" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\migration-abstractions\Orkyo.Migration.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Orkyo.Foundation.Tests" />
  </ItemGroup>
</Project>

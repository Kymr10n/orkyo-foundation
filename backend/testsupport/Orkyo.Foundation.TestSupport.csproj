<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Orkyo.Foundation.TestSupport</RootNamespace>
    <AssemblyName>Orkyo.Foundation.TestSupport</AssemblyName>

    <PackageId>Orkyo.Foundation.TestSupport</PackageId>
    <Version>0.1.0</Version>
    <Authors>Orkyo</Authors>
    <Description>Shared integration-test scaffolding (test auth handler, constants, product factory and database fixture bases, architecture contracts, control-plane/tenant DB helpers) consumed identically by every product's test project.</Description>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <!-- AuthenticationHandler / ILoggerFactory / IOptionsMonitor come from the ASP.NET shared framework. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Npgsql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\core\Orkyo.Foundation.Core.csproj" />
    <ProjectReference Include="..\migrator-runtime\Orkyo.Migrator.csproj" />
  </ItemGroup>
</Project>

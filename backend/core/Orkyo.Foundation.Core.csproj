<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Api</RootNamespace>

    <!-- NuGet packaging -->
    <PackageId>Orkyo.Foundation.Core</PackageId>
    <Description>Orkyo Foundation Core — domain models, services, repositories, validators, and interfaces shared across Orkyo product variants. No ASP.NET Core dependency; suitable for worker and CLI hosts.</Description>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <!-- Tests exercise a handful of internals (cache-clear hooks, SchedulingEngine/
         SharedRecurrenceRules helpers). The Web entry was dropped in 0.8.0 when
         NpgsqlQueryExtensions/UpdateBuilder became public — Web uses no core internals. -->
    <InternalsVisibleTo Include="Orkyo.Foundation.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\shared\Orkyo.Shared.csproj" />
  </ItemGroup>

  <!-- The shipped starter presets (StarterTemplateCatalog → PresetTemplateLoader). Embedded so
       the NuGet package carries them inside the DLL; no product image copies a file. -->
  <ItemGroup>
    <EmbeddedResource Include="Presets\*.preset.json" />
  </ItemGroup>

  <!-- No FrameworkReference — must remain ASP.NET-free -->
  <ItemGroup>
    <PackageReference Include="Anthropic" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="MailKit" />
    <PackageReference Include="Google.OrTools" />
    <PackageReference Include="StackExchange.Redis" />
  </ItemGroup>
</Project>

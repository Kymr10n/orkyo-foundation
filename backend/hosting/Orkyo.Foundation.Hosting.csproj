<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Api</RootNamespace>

    <!-- NuGet packaging -->
    <PackageId>Orkyo.Foundation.Hosting</PackageId>
    <Version>0.1.0</Version>
    <Authors>Orkyo</Authors>
    <Description>Orkyo Foundation Hosting — the generic-host entry point for the product background workers: Serilog bootstrap, tzdata probe, shared worker service graph, and the hosted loop. Depends on Orkyo.Foundation.Core. No ASP.NET Core dependency.</Description>
    <PackageTags>orkyo;scheduling;booking;foundation</PackageTags>
    <RepositoryUrl>https://github.com/Kymr10n/orkyo-foundation</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\core\Orkyo.Foundation.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Orkyo.Foundation.Tests" />
  </ItemGroup>

  <!-- No FrameworkReference — the worker images run the `dotnet/runtime` base, not
       `dotnet/aspnet`, so this package must stay ASP.NET-free. That rules out
       Serilog.AspNetCore (it carries a Microsoft.AspNetCore.App framework reference);
       Serilog.Extensions.Hosting is the generic-host half of it and is what both
       product workers already reference. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.Console" />
  </ItemGroup>
</Project>

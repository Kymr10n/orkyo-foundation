<Project>

  <PropertyGroup>
    <!-- Every project writes a packages.lock.json, so the locked-mode restore in CI
         (release-ci.yml) enforces the resolved graph instead of silently passing. Four
         projects (core, seeding, seeding-tests, testsupport) had no lock file, which made
         that flag a partial check; without this property new projects would keep missing
         it. The pre-commit hook regenerates and stages them when a csproj or the central
         version list changes. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Identical in every project in this repo, so they live here rather than being
         restated in each csproj. A project that genuinely differs can still override
         any of them locally. -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <!-- The central list governs transitive versions too, not only direct references.
         Without this a project can resolve an older patch of a package the central list
         already pins (seeding resolved Microsoft.Extensions.DependencyInjection.Abstractions
         at 10.0.0 while the list said 10.0.11), and the only other way to lift it is to add
         a direct PackageReference per project — which dependabot proposed and which spreads
         the same change across csproj files instead of stating it once.

         Measured cost: the pinned transitives become declared dependencies of the packages
         this repo publishes (Orkyo.Foundation.Core 7 to 10 entries, Orkyo.Foundation.Seed
         3 to 5). That is deliberate — it states a version floor consumers cannot resolve
         below, and the packages were already pulling them in. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

</Project>
